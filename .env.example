APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sentinel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Laravel Reverb (WebSocket)
REVERB_APP_ID=sentinel
REVERB_APP_KEY=sentinel-local-key
REVERB_APP_SECRET=sentinel-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OAuth Providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL="${APP_URL}/auth/github/callback"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/auth/google/callback"

# GitHub App (for repository integration)
GITHUB_APP_ID=
GITHUB_APP_NAME=
GITHUB_PRIVATE_KEY_PATH=storage/app/github/private-key.pem
GITHUB_WEBHOOK_SECRET=

# AI Provider Configuration (PrismPHP)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Review Context + Indexing Limits
REVIEW_ACK_COMMENT_UPDATES=true
REVIEW_FILE_CONTEXT_MAX_FILES=10
REVIEW_FILE_CONTEXT_MAX_FILE_SIZE=50000
REVIEW_SEMANTIC_MAX_FILES=15
REVIEW_SEMANTIC_MAX_FILE_SIZE=100000
REVIEW_IMPACT_MAX_SYMBOLS=25
REVIEW_IMPACT_MAX_FILES=20
REVIEW_IMPACT_MAX_FILE_SIZE=50000
REVIEW_IMPACT_SEARCH_LIMIT=50
REVIEW_IMPACT_MIN_SCORE=0.3
REVIEW_INDEXING_FULL_REINDEX_THRESHOLD=500
REVIEW_INDEXING_BATCH_SIZE=50
REVIEW_ADAPTIVE_LIMITS=false
REVIEW_ADAPTIVE_INDEXING_LIMITS=false
REVIEW_PR_PREINDEX_ENABLED=false
REVIEW_PR_PREINDEX_MODE=async
REVIEW_PR_PREINDEX_TIERS=illuminate,orchestrate,sanctum
REVIEW_PR_PREINDEX_MAX_FILES_CHANGED=120
REVIEW_PR_PREINDEX_MAX_LINES_CHANGED=8000
REVIEW_PR_PREINDEX_MAX_FILES=40
REVIEW_PR_PREINDEX_MAX_FILE_SIZE=120000
REVIEW_PR_PREINDEX_BATCH_SIZE=50
REVIEW_PR_HYBRID_SEARCH_ENABLED=true
REVIEW_PR_HYBRID_FALLBACK_TO_BASELINE=true


# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI="${APP_URL}/api/slack/callback"

# Polar Billing Configuration
POLAR_ACCESS_TOKEN=
POLAR_API_URL=https://api.polar.sh
POLAR_WEBHOOK_SECRET=

# Polar Product IDs (get from Polar dashboard)
POLAR_PRODUCT_ILLUMINATE_MONTHLY=
POLAR_PRODUCT_ORCHESTRATE_MONTHLY=
POLAR_PRODUCT_SANCTUM_MONTHLY=
POLAR_PRODUCT_ILLUMINATE_YEARLY=
POLAR_PRODUCT_ORCHESTRATE_YEARLY=
POLAR_PRODUCT_SANCTUM_YEARLY=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
